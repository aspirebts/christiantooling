# ChristianTooling environment variables
# Copy this file to .env.local and fill in values. Never commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical public URL. Used for auth email redirects, metadata and sitemaps.
# On Vercel, set it to your production domain (preview deployments fall back
# to VERCEL_URL automatically).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (required for authentication and data)
# ---------------------------------------------------------------------------
# Leave both blank to run in SAFE LOCAL MODE: public pages render, auth forms
# are disabled, and no network calls are made to Supabase.
#
# Hosted project: Supabase Dashboard > Project Settings > API Keys
#   - Project URL                -> NEXT_PUBLIC_SUPABASE_URL
#   - Publishable key (sb_publishable_...) -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# Local stack (npm run db:start): run `npx supabase status` and copy the API URL
# and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy projects only: if your project still uses the JWT-based anon key, you
# may set it here instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets (not used yet)
# ---------------------------------------------------------------------------
# Reserved for future server-side jobs such as payment webhooks. The secret key
# bypasses Row Level Security: keep it server-side and never prefix it with
# NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
